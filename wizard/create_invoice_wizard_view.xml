<odoo>

    <record id="create_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">create invoice wizard form</field>
        <field name="model">create.invoice</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <group>
                    <field name="quotation_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm_invoice" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>



    <record id="create_invoice_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Invoice</field>
        <field name="res_model">create.invoice</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
   </record>
</odoo>
